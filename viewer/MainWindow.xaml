<Window x:Class="ClxViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:ClxViewer.Controls"
        Title="Clx Viewer"
        Icon="Assets/clxviewer.ico"
        Width="1280" Height="820"
        MinWidth="940" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#1E1E1E"
        AllowDrop="True"
        Drop="OnDrop"
        PreviewKeyDown="OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Color x:Key="Bg0">#141414</Color>
        <Color x:Key="Bg1">#1E1E1E</Color>
        <Color x:Key="Bg2">#252526</Color>
        <Color x:Key="Bg3">#2D2D30</Color>
        <Color x:Key="BorderC">#3F3F46</Color>
        <Color x:Key="Accent">#012C5D</Color>
        <Color x:Key="AccentHi">#0F6CBB</Color>
        <Color x:Key="Text0">#F2F2F2</Color>
        <Color x:Key="Text1">#C8C8C8</Color>
        <Color x:Key="Dim">#8A8A8A</Color>

        <SolidColorBrush x:Key="BrBg0" Color="{StaticResource Bg0}"/>
        <SolidColorBrush x:Key="BrBg1" Color="{StaticResource Bg1}"/>
        <SolidColorBrush x:Key="BrBg2" Color="{StaticResource Bg2}"/>
        <SolidColorBrush x:Key="BrBg3" Color="{StaticResource Bg3}"/>
        <SolidColorBrush x:Key="BrBorder" Color="{StaticResource BorderC}"/>
        <SolidColorBrush x:Key="BrText0" Color="{StaticResource Text0}"/>
        <SolidColorBrush x:Key="BrText1" Color="{StaticResource Text1}"/>
        <SolidColorBrush x:Key="BrDim" Color="{StaticResource Dim}"/>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrText0}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrBg3}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource BrDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BrText1}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="12,4" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33373D"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrBg3}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource BrText1}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="10,4" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33373D"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14325C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrText1}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3A3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#2B2B30"/>
            <Setter Property="Foreground" Value="{StaticResource BrText0}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="{StaticResource BrText0}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrText0}"/>
            <Setter Property="SelectionBrush" Value="#0F6CBB"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource BrText0}"/>
            <Setter Property="Background" Value="{StaticResource BrBg3}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrBorder}"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                  Margin="8,0,22,0" IsHitTestVisible="False"/>
                                                <Path x:Name="arrow" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#9AA0A6"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#33373D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,0,22,0" IsHitTestVisible="False"
                                              VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="#252526" BorderBrush="{StaticResource BrBorder}"
                                        BorderThickness="1" CornerRadius="4" Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource BrText1}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14325C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource BrText1}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Foreground" Value="{StaticResource BrText1}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2D2D30"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#14325C"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" Opacity="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumb" Background="#4A4A50"
                                                        CornerRadius="4" Margin="2" MinHeight="24"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumb" Property="Background" Value="#63636B"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" Opacity="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BrBg1}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ============ Title bar ============ -->
        <Border Grid.Row="0" Background="{StaticResource BrBg2}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="pack://application:,,,/ClxViewer;component/Assets/clxviewer.png"
                           Width="18" Height="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Clx Viewer" Foreground="{StaticResource BrText0}"
                               FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WinBtn}" Content="&#xE921;" Click="OnMinimize"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource WinBtn}" x:Name="MaxBtn" Content="&#xE922;" Click="OnMaximize"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;" Click="OnClose"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Toolbar ============ -->
        <Border Grid.Row="1" Background="{StaticResource BrBg2}" BorderBrush="{StaticResource BrBorder}"
                BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolButton}" Click="OnOpen" ToolTip="Open .clx files (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Open" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" x:Name="PrevBtn" Click="OnPrev" IsEnabled="False"
                        ToolTip="Previous file (Left)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Prev" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" x:Name="NextBtn" Click="OnNext" IsEnabled="False"
                        ToolTip="Next file (Right)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Next" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{StaticResource BrBorder}" Height="20" Margin="8,0"/>

                <Border Background="#2D2D30" CornerRadius="6" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ViewFluo" Style="{StaticResource SegRadio}" Content="Fluo"
                                     GroupName="view" IsChecked="True" Checked="OnViewChecked" ToolTip="Fluorescence (F)"/>
                        <RadioButton x:Name="ViewBright" Style="{StaticResource SegRadio}" Content="Bright"
                                     GroupName="view" Checked="OnViewChecked" ToolTip="Brightfield (B)"/>
                        <RadioButton x:Name="ViewMerged" Style="{StaticResource SegRadio}" Content="Merged"
                                     GroupName="view" Checked="OnViewChecked" ToolTip="Merged (M)"/>
                    </StackPanel>
                </Border>

                <Border Width="1" Background="{StaticResource BrBorder}" Height="20" Margin="8,0"/>

                <ToggleButton x:Name="InvertBtn" Style="{StaticResource SegToggle}" Content="Invert"
                              IsChecked="True" Checked="OnInvertToggled" Unchecked="OnInvertToggled"
                              ToolTip="Reverse fluo colors (western-blot look) (I)"/>

                <Border Width="1" Background="{StaticResource BrBorder}" Height="20" Margin="8,0"/>

                <Button Style="{StaticResource ToolButton}" x:Name="AutoBtn" Click="OnAuto" ToolTip="Auto min/max (A)">
                    <TextBlock Text="Auto" VerticalAlignment="Center"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" x:Name="ExportRawBtn" Click="OnExportRaw" IsEnabled="False"
                        ToolTip="Export raw 16-bit TIFF(s) next to the .clx file (overwrites) (Ctrl+Shift+E)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Raw TIFF" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" x:Name="ExportPngBtn" Click="OnExportPng" IsEnabled="False"
                        ToolTip="Export the current view as 8-bit PNG with current min/max (Ctrl+E)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="PNG" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" x:Name="ExportDirBtn" Click="OnChooseExportDir"
                        ToolTip="Choose export folder (defaults to next to the .clx file) (Alt+E)">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                </Button>

                <Border Width="1" Background="{StaticResource BrBorder}" Height="20" Margin="8,0"/>

                <ToggleButton x:Name="ShortcutSheetBtn" Style="{StaticResource SegToggle}" Content="&#xE765;"
                              FontFamily="Segoe MDL2 Assets" ToolTip="Keyboard shortcuts"/>

                <ToggleButton x:Name="SidebarToggle" Style="{StaticResource SegToggle}" Content="&#xE700;"
                              IsChecked="True" FontFamily="Segoe MDL2 Assets" ToolTip="Toggle file list"/>
                <ToggleButton x:Name="MetaToggle" Style="{StaticResource SegToggle}" Content="&#xE946;"
                              IsChecked="True" FontFamily="Segoe MDL2 Assets" ToolTip="Toggle metadata panel"/>
            </StackPanel>
        </Border>

        <!-- Keyboard shortcut cheat sheet -->
        <Popup IsOpen="{Binding IsChecked, ElementName=ShortcutSheetBtn}"
               PlacementTarget="{Binding ElementName=ShortcutSheetBtn}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#252526" BorderBrush="{StaticResource BrBorder}" BorderThickness="1"
                    CornerRadius="6" Margin="0,4,0,0" Width="330">
                <StackPanel Margin="14,12,14,10">
                    <TextBlock Text="KEYBOARD SHORTCUTS" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource BrDim}" Margin="0,0,0,6"/>

                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ctrl+O" Foreground="#5EA6E0" FontSize="11.5"/>
                        <TextBlock Grid.Column="1" Text="Open .clx files" Foreground="{StaticResource BrText1}" FontSize="11.5"/>
                    </Grid>
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ctrl+E" Foreground="#5EA6E0" FontSize="11.5"/>
                        <TextBlock Grid.Column="1" Text="Export PNG (current view)" Foreground="{StaticResource BrText1}" FontSize="11.5"/>
                    </Grid>
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ctrl+Shift+E" Foreground="#5EA6E0" FontSize="11.5"/>
                        <TextBlock Grid.Column="1" Text="Export raw 16-bit TIFF" Foreground="{StaticResource BrText1}" FontSize="11.5"/>
                    </Grid>
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Alt+E" Foreground="#5EA6E0" FontSize="11.5"/>
                        <TextBlock Grid.Column="1" Text="Choose export folder" Foreground="{StaticResource BrText1}" FontSize="11.5"/>
                    </Grid>
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#x2190; / &#x2192;" Foreground="#5EA6E0" FontSize="11.5"/>
                        <TextBlock Grid.Column="1" Text="Previous / next file" Foreground="{StaticResource BrText1}" FontSize="11.5"/>
                    </Grid>
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="F / B / M" Foreground="#5EA6E0" FontSize="11.5"/>
                        <TextBlock Grid.Column="1" Text="Fluo / Bright / Merged" Foreground="{StaticResource BrText1}" FontSize="11.5"/>
                    </Grid>
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="A" Foreground="#5EA6E0" FontSize="11.5"/>
                        <TextBlock Grid.Column="1" Text="Auto min/max" Foreground="{StaticResource BrText1}" FontSize="11.5"/>
                    </Grid>
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="I" Foreground="#5EA6E0" FontSize="11.5"/>
                        <TextBlock Grid.Column="1" Text="Invert fluo colors" Foreground="{StaticResource BrText1}" FontSize="11.5"/>
                    </Grid>
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ctrl+W" Foreground="#5EA6E0" FontSize="11.5"/>
                        <TextBlock Grid.Column="1" Text="Close" Foreground="{StaticResource BrText1}" FontSize="11.5"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ============ Main ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- File list -->
            <Border Grid.Column="0" x:Name="Sidebar" Width="240" Background="{StaticResource BrBg2}"
                    BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="12,10,12,8" BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="FILES" FontSize="10.5" Foreground="{StaticResource BrDim}"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="FolderLabel" Text="—" FontSize="11" Foreground="{StaticResource BrText1}"
                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="20000"/>
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="FileList" Grid.Row="1" SelectionChanged="OnFileListSelectionChanged"
                             FontSize="12"/>
                </Grid>
            </Border>

            <!-- Image canvas -->
            <Grid Grid.Column="1" x:Name="CanvasHostGrid" Background="{StaticResource BrBg0}" ClipToBounds="True"
                  SizeChanged="OnCanvasHostSizeChanged"
                  MouseWheel="OnCanvasWheel" MouseDown="OnCanvasMouseDown" MouseMove="OnCanvasMouseMove"
                  MouseUp="OnCanvasMouseUp" Cursor="Cross">
                <Canvas x:Name="PanCanvas">
                    <Image x:Name="Img" RenderTransformOrigin="0,0" Stretch="None">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ZoomTf"/>
                                <TranslateTransform x:Name="PanTf"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Canvas>
                <TextBlock x:Name="EmptyHint" Text="Open a .clx file to begin"
                           Foreground="{StaticResource BrDim}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <!-- Metadata -->
            <Border Grid.Column="2" x:Name="MetaPanel" Width="297" Background="{StaticResource BrBg2}"
                    BorderBrush="{StaticResource BrBorder}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,12,14,8" BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,0,1">
                        <TextBlock Text="METADATA" FontSize="10.5" Foreground="{StaticResource BrDim}" FontWeight="SemiBold"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MetaList" Margin="14,10"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Range slider bar ============ -->
        <Border Grid.Row="3" Background="{StaticResource BrBg2}" BorderBrush="{StaticResource BrBorder}"
                BorderThickness="0,1,0,0" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Min" Foreground="{StaticResource BrDim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="MinBox" Width="72" FontSize="12" TextAlignment="Right" LostFocus="OnMinMaxBoxLostFocus"/>
                </StackPanel>

                <controls:DualRangeSlider x:Name="RangeSlider" Grid.Column="1"
                                          VerticalAlignment="Center" ValueChanged="OnRangeSliderChanged"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Max" Foreground="{StaticResource BrDim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="MaxBox" Width="72" FontSize="12" TextAlignment="Right" LostFocus="OnMinMaxBoxLostFocus"/>
                    <ComboBox x:Name="SliderChannelBox" Width="110" Margin="12,0,0,0"
                              FontSize="11.5" Visibility="Collapsed"
                              SelectionChanged="OnSliderChannelChanged">
                        <ComboBoxItem Content="Brightfield"/>
                        <ComboBoxItem Content="Fluorescence" IsSelected="True"/>
                    </ComboBox>
                    <Button Style="{StaticResource ToolButton}" Click="OnAuto" ToolTip="Auto min/max (A)">
                        <TextBlock Text="Auto" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="4" Background="#1A1A1A" BorderBrush="{StaticResource BrBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock x:Name="StatusFile" Text="—" Foreground="{StaticResource BrText1}" FontSize="11"/>
                    <TextBlock x:Name="StatusDims" Text="" Foreground="{StaticResource BrDim}" FontSize="11" Margin="12,0,0,0"/>
                    <TextBlock x:Name="StatusZoom" Text="" Foreground="{StaticResource BrDim}" FontSize="11" Margin="12,0,0,0"/>
                    <TextBlock x:Name="StatusPix" Text="" Foreground="{StaticResource BrText1}" FontSize="11" Margin="12,0,0,0"/>
                    <TextBlock x:Name="StatusExport" Text="" Foreground="{StaticResource BrDim}" FontSize="11" Margin="12,0,0,0"
                               ToolTipService.ShowDuration="30000"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Non-blocking toast notification -->
        <Border x:Name="Toast" Grid.RowSpan="5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="#2B2B30" BorderBrush="{StaticResource BrBorder}" BorderThickness="1"
                CornerRadius="6" Padding="14,10" Margin="0,0,18,16"
                Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#4CAF50" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastText" Text="" Foreground="{StaticResource BrText0}" FontSize="12"
                           Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="560" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
